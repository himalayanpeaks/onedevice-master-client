<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- The TMG master DLL (IOLUSBIF20_64.dll) is 64-bit. -->
    <PlatformTarget>x64</PlatformTarget>
    <IsPackable>false</IsPackable>
    <!-- DataTunnel is obsolete in Framework 2.5 but still the event type of the Master HAL. -->
    <NoWarn>$(NoWarn);CS0618</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OneDevice.MasterClient.Core.UnitTest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="OneDevice.Master.IoLink" Version="3.0.2" />
    <PackageReference Include="Microsoft.Azure.Devices.Client" Version="1.42.4" />
    <PackageReference Include="Microsoft.Azure.Devices.Provisioning.Client" Version="1.19.5" />
    <PackageReference Include="Microsoft.Azure.Devices.Provisioning.Transport.Mqtt" Version="1.17.5" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.5" />
    <PackageReference Include="System.Management" Version="10.0.15" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.15" />
  </ItemGroup>

</Project>
